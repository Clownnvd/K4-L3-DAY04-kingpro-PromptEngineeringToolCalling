# Day 04 Lab v4 — IT Helpdesk Agent
# Sao chép file này thành `.env`, điền key trên máy và không commit `.env`.

# Provider/model dùng cho toàn bộ evidence chính.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_COMPLETION_TOKENS=300
OPENAI_MAX_RETRIES=4

# Các lựa chọn dự phòng trên giao diện.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_COMPLETION_TOKENS=128
GROQ_MAX_RETRIES=6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MIN_INTERVAL_SECONDS=13
GEMINI_MAX_RETRIES=6

# Chỉ cần nếu dùng search_device_info. Bonus check_public_status không cần key.
TAVILY_API_KEY=
